{
  "type": "object",
  "required": ["code", "message", "timestamp"],
  "properties": {
    "code": {
      "type": "string",
      "description": "에러 코드",
      "enum": ["INVALID_REQUEST", "VALIDATION_ERROR", "DUPLICATE_ORDER", "ORDER_NOT_FOUND", "INVALID_STATE"],
      "example": "VALIDATION_ERROR"
    },
    "message": {
      "type": "string",
      "description": "에러 메시지",
      "example": "종목 코드는 6자리 숫자여야 합니다"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "에러 발생 시간",
      "example": "2025-10-15 01:22:19"
    }
  }
}
