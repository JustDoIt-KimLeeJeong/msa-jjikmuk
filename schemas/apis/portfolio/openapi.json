{
  "openapi": "3.1.0",
  "info": {
    "title": "Portfolio API",
    "version": "1.0.0",
    "description": "잔고 및 포지션 관리 API"
  },
  "servers": [
    {
      "url": "http://localhost:8082",
      "description": "Portfolio Service"
    }
  ],
  "paths": {
    "/api/portfolio/{userId}": {
      "get": {
        "summary": "포트폴리오 스냅샷 조회",
        "description": "사용자의 잔고 및 포지션 정보를 조회합니다.",
        "operationId": "getPortfolioSnapshot",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "사용자 ID"
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "사용자 ID (인증용)"
          }
        ],
        "responses": {
          "200": {
            "description": "포트폴리오 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSnapshotResponse"
                },
                "example": {
                  "userId": 1,
                  "balances": {
                    "available": 1200000,
                    "reserved": 0
                  },
                  "positions": [
                    {
                      "symbol": "005930.KS",
                      "qty": 10,
                      "avgPrice": 74000,
                      "realizedPnl": 3000
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "사용자 또는 포트폴리오를 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "userNotFound": {
                    "summary": "사용자를 찾을 수 없음",
                    "value": {
                      "code": "USER_NOT_FOUND",
                      "message": "사용자를 찾을 수 없습니다. userId: 999",
                      "timestamp": "2025-10-15 01:30:00"
                    }
                  },
                  "portfolioNotFound": {
                    "summary": "포트폴리오를 찾을 수 없음",
                    "value": {
                      "code": "PORTFOLIO_NOT_FOUND",
                      "message": "포트폴리오를 찾을 수 없습니다. userId: 1",
                      "timestamp": "2025-10-15 01:30:00"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Balance": {
        "$ref": "./balance.json"
      },
      "Position": {
        "$ref": "./position.json"
      },
      "PortfolioSnapshotResponse": {
        "$ref": "./portfolio-snapshot-response.json"
      },
      "ErrorResponse": {
        "$ref": "./error-response.json"
      }
    }
  }
}
