{
  "openapi": "3.1.0",
  "info": {
    "title": "Market Data API",
    "version": "1.0.0",
    "description": "시세, 호가, 차트 데이터 제공 API"
  },
  "servers": [
    {
      "url": "http://localhost:8084",
      "description": "Market Data Service"
    }
  ],
  "paths": {
    "/api/v1/market/symbols": {
      "get": {
        "summary": "심볼 목록 조회",
        "description": "고정 심볼 목록 + 메타데이터 및 검증 규칙 제공",
        "operationId": "getSymbols",
        "responses": {
          "200": {
            "description": "심볼 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SymbolsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/prices": {
      "get": {
        "summary": "여러 종목 현재가 일괄 조회",
        "description": "최대 30개 종목의 현재가를 일괄 조회합니다.",
        "operationId": "getPrices",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "종목 코드 목록 (CSV 형식, 최대 30개)",
            "example": "005930,000660,035420"
          }
        ],
        "responses": {
          "200": {
            "description": "현재가 조회 성공 (부분 실패 포함)",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "캐시 제어",
                "example": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricesResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청 (심볼 개수 초과 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/prices/{symbol}": {
      "get": {
        "summary": "단일 종목 현재가 조회",
        "description": "특정 종목의 현재가를 조회합니다.",
        "operationId": "getPriceBySymbol",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "종목 코드",
            "example": "005930"
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "사용자 ID (선택)"
          }
        ],
        "responses": {
          "200": {
            "description": "현재가 조회 성공",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "캐시 제어",
                "example": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Price"
                }
              }
            }
          },
          "404": {
            "description": "종목을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/prices/stream": {
      "get": {
        "summary": "현재가 실시간 스트림 (SSE)",
        "description": "여러 종목의 현재가를 실시간으로 스트리밍합니다.",
        "operationId": "streamPrices",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "종목 코드 목록 (CSV 형식, 최대 30개)",
            "example": "005930,000660"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 스트림 연결 성공",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 이벤트 스트림 (event: price)"
                },
                "example": "event: price\ndata: {\"items\":[{\"symbol\":\"005930\",\"name\":\"삼성전자\",\"last\":70100,\"chgPct\":-0.42,\"ts\":1737777777777}]}\n\n"
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/quotes/{symbol}": {
      "get": {
        "summary": "호가 조회",
        "description": "특정 종목의 호가 정보를 조회합니다.",
        "operationId": "getQuote",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "종목 코드",
            "example": "005930"
          }
        ],
        "responses": {
          "200": {
            "description": "호가 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "404": {
            "description": "종목을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/quotes/stream": {
      "get": {
        "summary": "호가 실시간 스트림 (SSE)",
        "description": "특정 종목의 호가를 실시간으로 스트리밍합니다.",
        "operationId": "streamQuotes",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "종목 코드 목록 (CSV 형식)",
            "example": "005930"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 스트림 연결 성공",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 이벤트 스트림 (event: quote)"
                },
                "example": "event: quote\ndata: {\"symbol\":\"005930\",\"bid\":70000,\"ask\":70100,\"bidSize\":1200,\"askSize\":950,\"ts\":1737777777777}\n\n"
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/candles/{symbol}": {
      "get": {
        "summary": "차트 히스토리 조회",
        "description": "특정 종목의 캔들 데이터를 조회합니다.",
        "operationId": "getCandles",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "종목 코드",
            "example": "005930"
          },
          {
            "name": "interval",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["1m", "1d", "1w"]
            },
            "description": "차트 간격",
            "example": "1m"
          }
        ],
        "responses": {
          "200": {
            "description": "캔들 데이터 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandlesResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청 (interval, 날짜 범위 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "종목을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/candles/stream": {
      "get": {
        "summary": "분봉 실시간 스트림 (SSE)",
        "description": "확정된 분봉 데이터를 실시간으로 스트리밍합니다.",
        "operationId": "streamCandles",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "종목 코드 목록 (CSV 형식)",
            "example": "005930"
          },
          {
            "name": "interval",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["1m", "1d", "1w"]
            },
            "description": "차트 간격",
            "example": "1m"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 스트림 연결 성공",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 이벤트 스트림 (event: candle)"
                },
                "example": "event: candle\\ndata: {\\\"symbol\\\":\\\"005930\\\",\\\"interval\\\":\\\"1m\\\",\\\"items\\\":[{\\\"ts\\\":\\\"2025-09-24T00:01:00Z\\\",\\\"o\\\":70100,\\\"h\\\":70200,\\\"l\\\":70000,\\\"c\\\":70150,\\\"v\\\":34567}]}\\n\\n"
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Symbol": {
        "$ref": "./symbol.json"
      },
      "SymbolsResponse": {
        "$ref": "./symbols-response.json"
      },
      "Price": {
        "$ref": "./price.json"
      },
      "PricesResponse": {
        "$ref": "./prices-response.json"
      },
      "Quote": {
        "$ref": "./quote.json"
      },
      "Candle": {
        "$ref": "./candle.json"
      },
      "CandlesResponse": {
        "$ref": "./candles-response.json"
      },
      "ErrorResponse": {
        "$ref": "./error-response.json"
      }
    }
  }
}
